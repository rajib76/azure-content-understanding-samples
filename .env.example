# Copy to .env and fill in your values (the script calls load_dotenv()).

# Required: your Microsoft Foundry resource endpoint
CONTENTUNDERSTANDING_ENDPOINT=https://your-foundry.services.ai.azure.com

# Optional: API key. Leave unset to use DefaultAzureCredential (az login).
# CONTENTUNDERSTANDING_KEY=

# Required: deployment names as they appear in Microsoft Foundry
CU_COMPLETION_MODEL_DEPLOYMENT=gpt-5.2
CU_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Optional overrides
# CU_COMPLETION_MODEL=gpt-5.2
# CU_COMPLETION_MODEL_MINI=
# CU_COMPLETION_MINI_DEPLOYMENT=
# CU_EMBEDDING_MODEL=text-embedding-3-large
